{
  "name": "@deepseek-ai/dsh-credentials-electron",
  "description": "OS-keychain-backed credentials provider for the DeepSeek Harness desktop shell: the managed store lives in Electron main behind safeStorage, reached over the desktop IPC carrier",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/credentials/credentials-electron"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-host-desktop-electron": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "tsx": "^4.19.2"
  }
}